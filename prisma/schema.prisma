generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductStatus {
  ATIVO
  INATIVO
}

model Product {
  id          String        @id @default(uuid())
  code        String        @unique @map("codigo_produto")
  description String        @map("descricao_produto")
  status      ProductStatus @default(ATIVO)
  image       String?       @map("foto_produto")
  thumbnail   String?       @map("foto_thumb")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
